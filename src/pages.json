{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^c-(.*)": "@/components/$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "植享家",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/wiki/index",
      "style": {
        "navigationBarTitleText": "植物百科"
      }
    },
    {
      "path": "pages/ai/index",
      "style": {
        "navigationBarTitleText": "AI识花"
      }
    },
    {
      "path": "pages/shop/index",
      "style": {
        "navigationBarTitleText": "助农商城"
      }
    },
    {
      "path": "pages/user/index",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/space/index",
      "style": {
        "navigationBarTitleText": "空间智能匹配"
      }
    },
    {
      "path": "pages/plants/index",
      "style": {
        "navigationBarTitleText": "我的植物"
      }
    },
    {
      "path": "pages/balcony/index",
      "style": {
        "navigationBarTitleText": "阳台种菜"
      }
    }

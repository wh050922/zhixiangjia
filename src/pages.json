    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/wiki/index",
        "text": "百科",
        "iconPath": "static/tabbar/wiki.png",
        "selectedIconPath": "static/tabbar/wiki-active.png"
      },
      {
        "pagePath": "pages/ai/index",
        "text": "AI识花",
        "iconPath": "static/tabbar/ai.png",
        "selectedIconPath": "static/tabbar/ai-active.png"
      },
      {
        "pagePath": "pages/shop/index",
        "text": "商城",
        "iconPath": "static/tabbar/shop.png",
        "selectedIconPath": "static/tabbar/shop-active.png"
      },
      {
        "pagePath": "pages/user/index",
        "text": "我的",
        "iconPath": "static/tabbar/user.png",
        "selectedIconPath": "static/tabbar/user-active.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "植享家",
    "navigationBarBackgroundColor": "#4CAF50",
    "backgroundColor": "#F5F7F5"
